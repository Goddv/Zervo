# Maintainer: Goddv <habitat.cristal@gmail.com>
#
# Generated by scripts/make-aur.sh — edit the template, not this file.
#
# The source package. This compiles the Servo engine, which takes hours and
# wants a lot of disk. `zervo-bin` installs the same release in seconds.

pkgname=zervo
pkgver=@VERSION@
pkgrel=1
pkgdesc='A sidebar-first browser built on the Servo engine'
arch=('x86_64')
url='https://github.com/Goddv/Zervo'
license=('MPL-2.0')

depends=(
    'fontconfig'
    'freetype2'
    'glib2'
    'glibc'
    'gst-plugins-bad-libs'
    'gst-plugins-base-libs'
    'gstreamer'
    'hicolor-icon-theme'
    'libgcc'
    'libglvnd'
    'libstdc++'
    'libx11'
    'libxcb'
    'libxkbcommon'
    'libxkbcommon-x11'
    'systemd-libs'
    'zlib'
)

# Servo's own build dependencies, translated from the apt list it publishes at
# python/servo/platform/linux_packages/apt/apt_common.txt. Servo's `mach
# bootstrap` has no pacman branch — it accepts Arch as a known distribution and
# then installs nothing at all — so this list is the only one that exists for
# Arch, and it has to be maintained by hand.
#
# Note the split packages: Arch keeps the GLib and GStreamer headers in
# `glib2-devel`, `gst-plugins-base-libs` and `gst-plugins-bad-libs`, so the
# runtime packages alone are not enough to build against. And `xorg-dev` is a
# Debian metapackage with no equivalent here; it is expanded below.
makedepends=(
    'cargo'
    'clang'
    'cmake'
    'dbus'
    'git'
    'glib2-devel'
    'gperf'
    'gst-editing-services'
    'gst-libav'
    'gst-plugins-good'
    'gst-plugins-ugly'
    'gst-rtsp-server'
    'harfbuzz'
    'libunwind'
    'libxcursor'
    'libxext'
    'libxfixes'
    'libxi'
    'libxinerama'
    'libxmu'
    'libxrandr'
    'libxrender'
    'llvm'
    'mesa'
    'python'
    'vulkan-icd-loader'
    'xorgproto'
    'xz'
)

# None of these are linked — the GStreamer plugins are dlopened by name, and
# the three programs are shelled out to — so nothing derives them from the
# built binary. Without them the feature silently does nothing.
optdepends=(
    'zenity: file chooser for <input type=file>'
    'xdg-utils: opening a finished download'
    'libsecret: storing passwords in the system keyring'
    'gst-plugins-good: audio and video playback'
    'gst-plugins-ugly: additional media formats'
    'gst-libav: additional media formats'
)

# Servo is a mixed Rust/C/C++ project — SpiderMonkey, ANGLE, HarfBuzz and
# FreeType are all compiled by build scripts — which is the case Arch's Rust
# packaging guidelines name for turning makepkg's LTO off. Rust's own LTO,
# configured in the release profile, still applies.
options=('!lto')

source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/zervo-$pkgver-src.tar.gz")
sha256sums=('@SHA256_SRC@')

prepare() {
    cd "$pkgname-$pkgver"

    # Zervo pins rustc 1.97.1 to match the engine's own toolchain file. Arch
    # ships `rust` 1.98, and its packaging guidelines build against the
    # distribution's compiler; leaving the pin in place would make rustup (if
    # the user has it) download a second toolchain in the middle of the build,
    # which breaks the offline guarantee `--frozen` is there to give. The pin
    # is a floor, not a ceiling — Cargo.toml's rust-version is 1.97.
    rm -f rust-toolchain.toml

    # Populates ~/.cargo from the lockfile, so build() can run offline. The
    # engine is a git dependency (a Servo fork carrying two patches, see
    # docs/SERVO.md), so this fetch is large.
    export CARGO_TARGET_DIR=target
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export CARGO_TARGET_DIR=target
    # Not --all-features: `engine-downloads` and `media` are both wanted, but a
    # blanket --all-features would also pick up anything added later without
    # anyone deciding to.
    cargo build --frozen --release --features engine-downloads,media
}

check() {
    cd "$pkgname-$pkgver"
    export CARGO_TARGET_DIR=target
    # --release, against Arch's guidelines, and deliberately. The guideline
    # exists because a release profile turns off overflow checks and
    # debug_assert!. The alternative here is compiling the Servo engine a
    # second time in a second profile, which on this package means hours —
    # and the tests are arithmetic, colour and file handling, none of which
    # is what a browser's engine build is for.
    cargo test --frozen --release --workspace
}

package() {
    cd "$pkgname-$pkgver"

    install -Dm755 target/release/zervo "$pkgdir/usr/bin/zervo"
    install -Dm644 assets/linux/app.zervo.Zervo.desktop \
        "$pkgdir/usr/share/applications/app.zervo.Zervo.desktop"
    install -Dm644 assets/icon/zervo-icon-default.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/zervo.svg"
    for _size in 128 256 512; do
        install -Dm644 "assets/icon/zervo-$_size.png" \
            "$pkgdir/usr/share/icons/hicolor/${_size}x${_size}/apps/zervo.png"
    done
    install -Dm644 assets/linux/app.zervo.Zervo.metainfo.xml \
        "$pkgdir/usr/share/metainfo/app.zervo.Zervo.metainfo.xml"
    install -Dm644 assets/linux/zervo.1 "$pkgdir/usr/share/man/man1/zervo.1"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
