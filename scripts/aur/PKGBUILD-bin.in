# Maintainer: Goddv <habitat.cristal@gmail.com>
#
# Generated by scripts/make-aur.sh — edit the template, not this file.
#
# The binary package. Zervo compiles the Servo engine from source, which is a
# multi-hour build on a desktop machine, so this is the one most people will
# want; `zervo` builds the same release from source for anyone who would rather.

pkgname=zervo-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='A sidebar-first browser built on the Servo engine'
arch=('x86_64')
url='https://github.com/Goddv/Zervo'
license=('MPL-2.0')
provides=("zervo=$pkgver")
conflicts=('zervo')

# Worked out from the shipped binary with `namcap`, and matched against what
# `servo-bin` depends on, since the engine is the same one.
depends=(
    'fontconfig'
    'freetype2'
    'glib2'
    'glibc'
    'gst-plugins-bad-libs'
    'gst-plugins-base-libs'
    'gstreamer'
    'hicolor-icon-theme'
    'libgcc'
    'libglvnd'
    'libstdc++'
    'libx11'
    'libxcb'
    'libxkbcommon'
    'libxkbcommon-x11'
    'systemd-libs'
    'zlib'
)

# Everything Zervo shells out to. None of them are linked, so nothing derives
# them from the binary, and without them the feature quietly does nothing.
optdepends=(
    'zenity: file chooser for <input type=file>'
    'xdg-utils: opening a finished download'
    'libsecret: storing passwords in the system keyring'
    'gst-plugins-good: audio and video playback'
    'gst-plugins-ugly: additional media formats'
    'gst-libav: additional media formats'
)

source=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/zervo-$pkgver-x86_64-linux-gnu.tar.gz")
sha256sums=('@SHA256_X86_64@')

package() {
    local _root="$srcdir/zervo-$pkgver-x86_64-linux-gnu"

    install -Dm755 "$_root/bin/zervo" "$pkgdir/usr/bin/zervo"
    install -Dm644 "$_root/share/applications/app.zervo.Zervo.desktop" \
        "$pkgdir/usr/share/applications/app.zervo.Zervo.desktop"
    install -Dm644 "$_root/share/icons/hicolor/scalable/apps/zervo.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/zervo.svg"
    for _size in 128 256 512; do
        install -Dm644 "$_root/share/icons/hicolor/${_size}x${_size}/apps/zervo.png" \
            "$pkgdir/usr/share/icons/hicolor/${_size}x${_size}/apps/zervo.png"
    done
    install -Dm644 "$_root/share/metainfo/app.zervo.Zervo.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/app.zervo.Zervo.metainfo.xml"
    install -Dm644 "$_root/share/man/man1/zervo.1.gz" \
        "$pkgdir/usr/share/man/man1/zervo.1.gz"
    install -Dm644 "$_root/share/licenses/zervo/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
