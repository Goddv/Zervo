+  if (updating) {
+    schedule_event_unlocked (self, ON_ABORT);
+    schedule_event_unlocked (self, ON_UPDATE_END);
+  }
+  GST_OBJECT_UNLOCK (self);
+  if (!flushed)
+    g_set_error (error, GST_MEDIA_SOURCE_ERROR,
+        GST_MEDIA_SOURCE_ERROR_INVALID_STATE, "failed to flush source buffer");
+  return flushed;
+}
+
+void
+gst_source_buffer_finish (GstSourceBuffer * self)
+{
+  gst_append_pipeline_eos (self->append_pipeline);
 }

