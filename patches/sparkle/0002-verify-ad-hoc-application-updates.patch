+// The trailer is part of the signed delta. Its SHA-256 digest authenticates
+// the reconstructed app's sealed executable independently of its ad-hoc ID.
+- (BOOL)validateAdHocDeltaWithPublicKeys:(SUPublicKeys *)publicKeys error:(NSError * __autoreleasing *)error
+{
+    static const char marker[] = "ZERVOD01";
+    const NSUInteger markerLength = sizeof(marker) - 1;
+    const NSUInteger trailerLength = markerLength + CC_SHA256_DIGEST_LENGTH;
+    NSData *data = [NSData dataWithContentsOfFile:_downloadPath options:NSDataReadingMappedIfSafe error:error];
+    if (data == nil) {
+        return NO;
+    }
+    if (![_downloadPath.pathExtension isEqualToString:@"delta"] || data.length <= trailerLength ||
+        publicKeys.ed25519PubKeyStatus != SUSigningInputStatusPresent ||
+        memcmp((const unsigned char *)data.bytes + data.length - trailerLength, marker, markerLength) != 0) {
+        if (error != NULL) {
+            *error = [NSError errorWithDomain:SUSparkleErrorDomain code:SUValidationError userInfo:@{ NSLocalizedDescriptionKey: @"The update is missing the signed Zervo delta trailer." }];
+        }
+        return NO;
+    }
+    SUSignatureVerifier *verifier = [[SUSignatureVerifier alloc] initWithPublicKeys:publicKeys];
+    if (![verifier verifyData:data signatures:_signatures fileKind:@"update" verifierInformation:_verifierInformation error:error]) {
+        return NO;
+    }
+    _expectedUpdateExecutableDigest = [data subdataWithRange:NSMakeRange(data.length - CC_SHA256_DIGEST_LENGTH, CC_SHA256_DIGEST_LENGTH)];
+    _prevalidatedSignature = YES;
+    return YES;
+}
