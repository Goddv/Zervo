+- (BOOL)validateStagedAdHocBundle:(NSBundle *)bundle host:(SUHost *)newHost error:(NSError * __autoreleasing *)error
+{
+    NSString *installedKey = [_host.bundle objectForInfoDictionaryKey:@"SUPublicEDKey"];
+    NSString *stagedKey = [bundle objectForInfoDictionaryKey:@"SUPublicEDKey"];
+    if (![installedKey isEqual:stagedKey] ||
+        ![bundle.bundleIdentifier isEqualToString:_host.bundle.bundleIdentifier] ||
+        ![newHost.version isEqualToString:_verifierInformation.expectedVersion] ||
+        ![SUCodeSigningVerifier bundleAtURLIsAdHocSigned:bundle.bundleURL]) {
+        if (error != NULL) {
+            *error = [NSError errorWithDomain:SUSparkleErrorDomain code:SUValidationError userInfo:@{ NSLocalizedDescriptionKey: @"The staged update has an unexpected app identity, version, or update key." }];
+        }
+        return NO;
+    }
+    if (![SUCodeSigningVerifier codeSignatureIsValidAtBundleURL:bundle.bundleURL checkNestedCode:YES error:error]) {
+        return NO;
+    }
+    NSURL *executable = bundle.executableURL;
+    NSData *data = executable != nil ? [NSData dataWithContentsOfURL:executable options:NSDataReadingMappedIfSafe error:error] : nil;
+    unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+    if (data.length > 0 && data.length <= UINT32_MAX &&
+        CC_SHA256(data.bytes, (CC_LONG)data.length, digest) != NULL &&
+        memcmp(digest, _expectedUpdateExecutableDigest.bytes, sizeof(digest)) == 0) {
+        return YES;
+    }
+    if (error != NULL) {
+        *error = [NSError errorWithDomain:SUSparkleErrorDomain code:SUValidationError userInfo:@{ NSLocalizedDescriptionKey: @"The staged executable does not match the signed update digest." }];
+    }
+    return NO;
+}
