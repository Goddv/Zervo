+            if let Some(live) = &mut live {
+                live.start = live.start.min(first.start);
+                live.end = live.end.max(last.end);
+            } else {
+                live = Some(0.0..last.end);
+            }
+        }
+        live.into_iter().collect()
+    }
+
+    fn queue_event(&self, name: Atom) {
+        let this = Trusted::new(self);
+        self.global()
+            .task_manager()
+            .media_element_task_source()
+            .queue(task!(media_source_event: move |cx| {
+                this.root().upcast::<EventTarget>().fire_event(cx, name);
+            }));
+    }
+
+    fn require_open(&self) -> ErrorResult {
+        if self.ready_state() != ReadyState::Open {
+            return Err(Error::InvalidState(None));
+        }
+        Ok(())
+    }
+
+    fn require_idle_buffers(&self) -> ErrorResult {
+        if self
+            .buffers
+            .items()
+            .iter()
+            .any(|buffer| buffer.is_updating())
+        {
+            return Err(Error::InvalidState(None));
+        }
+        Ok(())
+    }
+}
+
+impl MediaSourceMethods<crate::DomTypeHolder> for MediaSource {
+    fn Constructor(
+        cx: &mut JSContext,
+        window: &Window,
+        proto: Option<HandleObject>,
+    ) -> Fallible<DomRoot<Self>> {
+        let backend = ServoMedia::get()
+            .create_media_source()
+            .ok_or(Error::NotSupported(None))?;
+        let buffers = SourceBufferList::new(cx, window);
+        let active_buffers = SourceBufferList::new(cx, window);
+        Ok(reflect_dom_object_with_proto(
+            cx,
+            Box::new(Self {
+                eventtarget: EventTarget::new_inherited(),
+                buffers: Dom::from_ref(&*buffers),
+                active_buffers: Dom::from_ref(&*active_buffers),
+                backend,
+                live_range: RefCell::new(None),
+            }),
+            window,
+            proto,
+        ))
+    }
+
+    fn SourceBuffers(&self) -> DomRoot<SourceBufferList> {
+        DomRoot::from_ref(&*self.buffers)
+    }
+
+    fn ActiveSourceBuffers(&self) -> DomRoot<SourceBufferList> {
+        self.refresh_active_buffers();
+        DomRoot::from_ref(&*self.active_buffers)
+    }
+
+    fn ReadyState(&self) -> MediaSourceReadyState {
+        match self.ready_state() {
+            ReadyState::Closed => MediaSourceReadyState::Closed,
+            ReadyState::Open => MediaSourceReadyState::Open,
+            ReadyState::Ended => MediaSourceReadyState::Ended,
+        }
+    }
+
+    fn Duration(&self) -> f64 {
+        if self.ready_state() == ReadyState::Closed {
+            return f64::NAN;
+        }
+        self.backend.duration()
+    }
+
+    fn SetDuration(&self, duration: f64) -> ErrorResult {
+        if duration.is_nan() || duration < 0. {
+            return Err(Error::Type(cformat!("Invalid media duration")));
+        }
+        self.require_open()?;
+        self.require_idle_buffers()?;
+        self.backend.set_duration(duration).map_err(dom_error)
+    }
+
+    fn AddSourceBuffer(
+        &self,
+        cx: &mut JSContext,
+        media_type: DOMString,
+    ) -> Fallible<DomRoot<SourceBuffer>> {
+        if media_type.is_empty() {
+            return Err(Error::Type(cformat!(
+                "A source buffer needs a content type"
+            )));
+        }
+        if !ServoMedia::get().supports_media_source_type(&media_type.str()) {
+            return Err(Error::NotSupported(None));
+        }
+        self.require_open()?;
+        let backend = self
+            .backend
+            .add_buffer(&media_type.str())
+            .map_err(dom_error)?;
+        let buffer = SourceBuffer::new(cx, self, backend);
+        self.buffers.push(&buffer);
+        Ok(buffer)
+    }
+
+    fn RemoveSourceBuffer(&self, buffer: &SourceBuffer) -> ErrorResult {
+        if !self.has_buffer(buffer) {
+            return Err(Error::NotFound(None));
+        }
+        self.backend
+            .remove_buffer(buffer.backend())
+            .map_err(dom_error)?;
+        self.active_buffers.remove(buffer);
+        self.buffers.remove(buffer);
+        Ok(())
+    }
+
+    fn EndOfStream(&self, reason: Option<EndOfStreamError>) -> ErrorResult {
+        self.require_open()?;
+        self.require_idle_buffers()?;
+        let reason = match reason {
+            None => EndOfStream::Normal,
+            Some(EndOfStreamError::Network) => EndOfStream::Network,
+            Some(EndOfStreamError::Decode) => EndOfStream::Decode,
+        };
+        self.backend.end_of_stream(reason).map_err(dom_error)?;
+        self.queue_event(Atom::from("sourceended"));
+        Ok(())
+    }
+
+    fn SetLiveSeekableRange(&self, start: Finite<f64>, end: Finite<f64>) -> ErrorResult {
+        self.require_open()?;
+        if *start < 0. || *end < *start {
+            return Err(Error::Type(cformat!("Invalid live seekable range")));
+        }
+        let range = *start..*end;
+        self.backend
+            .set_live_seekable_range(range.clone())
+            .map_err(dom_error)?;
+        *self.live_range.borrow_mut() = Some(range);
+        Ok(())
+    }
+
+    fn ClearLiveSeekableRange(&self) -> ErrorResult {
+        self.require_open()?;
+        self.backend
+            .clear_live_seekable_range()
+            .map_err(dom_error)?;
+        self.live_range.borrow_mut().take();
+        Ok(())
+    }
+
+    fn IsTypeSupported(_window: &Window, media_type: DOMString) -> bool {
+        ServoMedia::get().supports_media_source_type(&media_type.str())
+    }
+
+    event_handler!(sourceopen, GetOnsourceopen, SetOnsourceopen);
+    event_handler!(sourceended, GetOnsourceended, SetOnsourceended);
+    event_handler!(sourceclose, GetOnsourceclose, SetOnsourceclose);
+}
+
+pub(super) fn dom_error(error: MediaSourceError) -> Error {
+    match error {
+        MediaSourceError::InvalidState => Error::InvalidState(None),
+        MediaSourceError::InvalidType => Error::Type(cformat!("Invalid media source argument")),
+        MediaSourceError::NotSupported => Error::NotSupported(None),
+        MediaSourceError::NotFound => Error::NotFound(None),
+        MediaSourceError::QuotaExceeded => Error::QuotaExceeded {
+            quota: None,
+            requested: None,
+        },
+    }
+}
