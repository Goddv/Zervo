diff --git a/components/script/dom/media/sourcebuffer.rs b/components/script/dom/media/sourcebuffer.rs
new file mode 100644
index 00000000000..088c030fe35
--- /dev/null
+++ b/components/script/dom/media/sourcebuffer.rs
@@ -0,0 +1,270 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+use std::rc::Rc;
+use std::sync::Mutex;
+
+use dom_struct::dom_struct;
+use js::context::JSContext;
+use script_bindings::cformat;
+use script_bindings::reflector::reflect_weak_referenceable_dom_object_with_proto;
+use servo_media::ServoMedia;
+use servo_media::player::media_source::{ReadyState, SourceBuffer as Backend, SourceBufferEvent};
+use stylo_atoms::Atom;
+use uuid::Uuid;
+
+use crate::dom::bindings::codegen::Bindings::SourceBufferBinding::{
+    AppendMode, SourceBufferMethods,
+};
+use crate::dom::bindings::codegen::UnionTypes::ArrayBufferViewOrArrayBuffer;
+use crate::dom::bindings::error::{Error, ErrorResult, Fallible};
+use crate::dom::bindings::inheritance::Castable;
+use crate::dom::bindings::num::Finite;
+use crate::dom::bindings::reflector::DomGlobal;
+use crate::dom::bindings::root::{Dom, DomRoot};
+use crate::dom::bindings::str::DOMString;
+use crate::dom::bindings::weakref::WeakRef;
+use crate::dom::eventtarget::EventTarget;
+use crate::dom::mediasource::{MediaSource, dom_error};
+use crate::dom::timeranges::{TimeRanges, TimeRangesContainer};
+
+thread_local! {
+    static EVENT_TARGETS: RefCell<HashMap<Uuid, WeakRef<SourceBuffer>>> = RefCell::new(HashMap::new());
+}
+
+struct EventRegistration(Uuid);
+
+impl Drop for EventRegistration {
+    fn drop(&mut self) {
+        let _ = EVENT_TARGETS.try_with(|targets| targets.borrow_mut().remove(&self.0));
+    }
+}
+
+#[dom_struct]
+pub(crate) struct SourceBuffer {
+    eventtarget: EventTarget,
+    source: Dom<MediaSource>,
+    #[no_trace]
+    #[ignore_malloc_size_of = "Allocated by the media backend"]
+    backend: Box<dyn Backend>,
+    #[no_trace]
+    #[ignore_malloc_size_of = "Fixed-size identifier"]
+    _registration: EventRegistration,
+    updating: Cell<bool>,
+}
+
+impl SourceBuffer {
+    pub(crate) fn new(
+        cx: &mut JSContext,
+        source: &MediaSource,
+        backend: Box<dyn Backend>,
+    ) -> DomRoot<Self> {
+        let id = Uuid::new_v4();
+        let global = source.global();
+        let buffer = reflect_weak_referenceable_dom_object_with_proto(
+            cx,
+            Rc::new(Self {
+                eventtarget: EventTarget::new_inherited(),
+                source: Dom::from_ref(source),
+                backend,
+                _registration: EventRegistration(id),
+                updating: Cell::new(false),
+            }),
+            &*global,
+            None,
+        );
+        EVENT_TARGETS.with(|targets| targets.borrow_mut().insert(id, WeakRef::new(&*buffer)));
+        let tasks = Mutex::new(
+            global
+                .task_manager()
+                .media_element_task_source()
+                .to_sendable(),
+        );
+        buffer.backend.set_event_callback(Box::new(move |event| {
+            tasks.lock().unwrap().queue(task!(source_buffer_event: move |cx| {
+                let target = EVENT_TARGETS.with(|targets| targets.borrow().get(&id).and_then(WeakRef::root));
+                if let Some(target) = target {
+                    target.dispatch_event(cx, event);
+                }
+            }));
+        }));
+        buffer
+    }
+
+    pub(crate) fn backend(&self) -> &dyn Backend {
+        &*self.backend
+    }
+
+    pub(crate) fn is_updating(&self) -> bool {
+        self.updating.get()
+    }
+
+    fn dispatch_event(&self, cx: &mut JSContext, event: SourceBufferEvent) {
+        let name = match event {
+            SourceBufferEvent::UpdateStart => Atom::from("updatestart"),
+            SourceBufferEvent::Update => Atom::from("update"),
+            SourceBufferEvent::UpdateEnd => Atom::from("updateend"),
+            SourceBufferEvent::Abort => Atom::from("abort"),
+            SourceBufferEvent::Error => Atom::from("error"),
+        };
+        if matches!(
+            event,
+            SourceBufferEvent::Update | SourceBufferEvent::Abort | SourceBufferEvent::Error
+        ) {
+            self.updating.set(false);
+        }
+        if matches!(event, SourceBufferEvent::Update) {
+            self.source.refresh_active_buffers();
+        }
+        self.upcast::<EventTarget>().fire_event(cx, name);
+    }
+
+    fn ensure_attached(&self) -> ErrorResult {
+        if !self.source.has_buffer(self) {
+            return Err(Error::InvalidState(None));
+        }
+        Ok(())
+    }
+
+    fn ensure_idle(&self) -> ErrorResult {
+        self.ensure_attached()?;
+        if self.Updating() {
+            return Err(Error::InvalidState(None));
+        }
+        Ok(())
+    }
+}
+
+impl SourceBufferMethods<crate::DomTypeHolder> for SourceBuffer {
+    fn Mode(&self) -> AppendMode {
+        if self.backend.sequence_mode() {
+            AppendMode::Sequence
+        } else {
+            AppendMode::Segments
+        }
+    }
+
+    fn SetMode(&self, mode: AppendMode) -> ErrorResult {
+        self.ensure_idle()?;
+        let state = self.source.ready_state();
+        self.backend
+            .set_sequence_mode(mode == AppendMode::Sequence)
+            .map_err(dom_error)?;
+        self.source.update_after_buffer_operation(state);
+        Ok(())
+    }
+
+    fn Updating(&self) -> bool {
+        self.is_updating()
+    }
+
+    fn GetBuffered(&self, cx: &mut JSContext) -> Fallible<DomRoot<TimeRanges>> {
+        self.ensure_attached()?;
+        let mut ranges = TimeRangesContainer::default();
+        for range in self.backend.buffered().map_err(dom_error)? {
+            let _ = ranges.add(range.start, range.end);
+        }
+        Ok(TimeRanges::new(cx, self.global().as_window(), ranges))
+    }
+
+    fn TimestampOffset(&self) -> Finite<f64> {
+        Finite::wrap(self.backend.timestamp_offset())
+    }
+
+    fn SetTimestampOffset(&self, offset: Finite<f64>) -> ErrorResult {
+        self.ensure_idle()?;
+        let state = self.source.ready_state();
+        self.backend
+            .set_timestamp_offset(*offset)
+            .map_err(dom_error)?;
+        self.source.update_after_buffer_operation(state);
+        Ok(())
+    }
+
+    fn AppendWindowStart(&self) -> Finite<f64> {
+        Finite::wrap(self.backend.append_window().start)
+    }
+
+    fn SetAppendWindowStart(&self, value: Finite<f64>) -> ErrorResult {
+        self.ensure_idle()?;
+        if *value < 0. || *value >= self.backend.append_window().end {
+            return Err(Error::Type(cformat!("Invalid append window start")));
+        }
+        self.backend
+            .set_append_window_start(*value)
+            .map_err(dom_error)
+    }
+
+    fn AppendWindowEnd(&self) -> f64 {
+        self.backend.append_window().end
+    }
+
+    fn SetAppendWindowEnd(&self, value: f64) -> ErrorResult {
+        self.ensure_idle()?;
+        if value.is_nan() || value <= self.backend.append_window().start {
+            return Err(Error::Type(cformat!("Invalid append window end")));
+        }
+        self.backend.set_append_window_end(value).map_err(dom_error)
+    }
+
+    fn AppendBuffer(&self, bytes: ArrayBufferViewOrArrayBuffer) -> ErrorResult {
+        self.ensure_idle()?;
+        let bytes = match bytes {
+            ArrayBufferViewOrArrayBuffer::ArrayBuffer(buffer) => buffer.to_vec(),
+            ArrayBufferViewOrArrayBuffer::ArrayBufferView(view) => view.to_vec(),
+        }
+        .ok_or_else(|| Error::Type(cformat!("Cannot append a detached buffer")))?;
+        let state = self.source.ready_state();
+        self.backend.append(bytes).map_err(dom_error)?;
+        self.updating.set(true);
+        self.source.update_after_buffer_operation(state);
+        Ok(())
+    }
+
+    fn Abort(&self) -> ErrorResult {
+        self.ensure_attached()?;
+        if self.source.ready_state() != ReadyState::Open {
+            return Err(Error::InvalidState(None));
+        }
+        self.backend.abort().map_err(dom_error)
+    }
+
+    fn Remove(&self, start: Finite<f64>, end: f64) -> ErrorResult {
+        self.ensure_idle()?;
+        if *start < 0. || end.is_nan() || end <= *start {
+            return Err(Error::Type(cformat!("Invalid removal range")));
+        }
+        let state = self.source.ready_state();
+        self.backend.remove(*start..end).map_err(dom_error)?;
+        self.updating.set(true);
+        self.source.update_after_buffer_operation(state);
+        Ok(())
+    }
+
+    fn ChangeType(&self, media_type: DOMString) -> ErrorResult {
+        if media_type.is_empty() {
+            return Err(Error::Type(cformat!(
+                "A source buffer needs a content type"
+            )));
+        }
+        self.ensure_idle()?;
+        if !ServoMedia::get().supports_media_source_type(&media_type.str()) {
+            return Err(Error::NotSupported(None));
+        }
+        let state = self.source.ready_state();
+        self.backend
+            .change_type(&media_type.str())
+            .map_err(dom_error)?;
+        self.source.update_after_buffer_operation(state);
+        Ok(())
+    }
+
+    event_handler!(updatestart, GetOnupdatestart, SetOnupdatestart);
+    event_handler!(update, GetOnupdate, SetOnupdate);
+    event_handler!(updateend, GetOnupdateend, SetOnupdateend);
+    event_handler!(error, GetOnerror, SetOnerror);
+    event_handler!(abort, GetOnabort, SetOnabort);
+}
