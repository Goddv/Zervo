+    fn remove(&self, range: Range<f64>) -> Result<(), MediaSourceError>;
+    fn abort(&self) -> Result<(), MediaSourceError>;
+    fn change_type(&self, media_type: &str) -> Result<(), MediaSourceError>;
+    fn sequence_mode(&self) -> bool;
+    fn set_sequence_mode(&self, enabled: bool) -> Result<(), MediaSourceError>;
+    fn timestamp_offset(&self) -> f64;
+    fn set_timestamp_offset(&self, seconds: f64) -> Result<(), MediaSourceError>;
+    fn append_window(&self) -> Range<f64>;
+    fn set_append_window_start(&self, seconds: f64) -> Result<(), MediaSourceError>;
+    fn set_append_window_end(&self, seconds: f64) -> Result<(), MediaSourceError>;
+}
