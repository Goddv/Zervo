+#[dom_struct]
+pub(crate) struct MediaSource {
+    eventtarget: EventTarget,
+    buffers: Dom<SourceBufferList>,
+    active_buffers: Dom<SourceBufferList>,
+    #[no_trace]
+    #[ignore_malloc_size_of = "Allocated by the media backend"]
+    backend: Box<dyn Backend>,
+    #[no_trace]
+    live_range: RefCell<Option<Range<f64>>>,
