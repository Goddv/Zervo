+
+impl MediaSource {
+    pub(crate) fn attach(&self, player: &dyn Player) -> Result<(), ()> {
+        player.attach_media_source(&*self.backend).map_err(|_| ())?;
+        self.queue_event(Atom::from("sourceopen"));
+        Ok(())
+    }
+
+    pub(crate) fn detach(&self) {
+        if self.backend.ready_state() == ReadyState::Closed {
+            return;
+        }
+        self.backend.detach();
+        for buffer in self.buffers.items() {
+            self.active_buffers.remove(&buffer);
+            self.buffers.remove(&buffer);
+        }
+        self.live_range.borrow_mut().take();
+        self.queue_event(Atom::from("sourceclose"));
+    }
+
+    pub(crate) fn ready_state(&self) -> ReadyState {
+        self.backend.ready_state()
+    }
+
+    pub(crate) fn update_after_buffer_operation(&self, old_state: ReadyState) {
+        if old_state == ReadyState::Ended && self.ready_state() == ReadyState::Open {
+            self.queue_event(Atom::from("sourceopen"));
+        }
+    }
+
+    pub(crate) fn has_buffer(&self, buffer: &SourceBuffer) -> bool {
+        self.buffers.contains(buffer)
+    }
+
+    pub(crate) fn refresh_active_buffers(&self) {
+        for buffer in self.buffers.items() {
+            let active = self.backend.buffer_is_active(buffer.backend());
+            let listed = self.active_buffers.contains(&buffer);
+            if active && !listed {
+                self.active_buffers.push(&buffer);
+            } else if listed && !active {
+                self.active_buffers.remove(&buffer);
+            }
+        }
+    }
+
+    pub(crate) fn buffered(&self) -> Vec<Range<f64>> {
+        self.refresh_active_buffers();
+        let buffers = self.active_buffers.items();
+        let mut ranges = buffers
+            .iter()
+            .map(|buffer| buffer.backend().buffered().unwrap_or_default());
