+    Open,
+    Ended,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub enum EndOfStream {
+    Normal,
+    Network,
+    Decode,
+}
+
+#[derive(Debug)]
+pub enum MediaSourceError {
