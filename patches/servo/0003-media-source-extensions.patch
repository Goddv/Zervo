diff --git a/components/media/backends/gstreamer/media_source.rs b/components/media/backends/gstreamer/media_source.rs
new file mode 100644
index 00000000000..fba5cf5f010
--- /dev/null
+++ b/components/media/backends/gstreamer/media_source.rs
@@ -0,0 +1,240 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+use std::any::Any;
+use std::ops::Range;
+use std::ptr;
+use std::sync::Arc;
+
+use glib::translate::{ToGlibPtr, from_glib_full};
+use gstreamer::ClockTime;
+use gstreamer_mse::{MediaSourceEOSError, MediaSourceReadyState, MseSrc, SourceBufferAppendMode};
+use servo_media_player::media_source::{
+    EndOfStream, MediaSource, MediaSourceError as Error, ReadyState, SourceBuffer,
+    SourceBufferCallback, SourceBufferEvent as Event,
+};
+
+#[derive(Clone)]
+pub(crate) struct GStreamerMediaSource(gstreamer_mse::MediaSource);
+
+impl GStreamerMediaSource {
+    pub(crate) fn new() -> Self {
+        Self(gstreamer_mse::MediaSource::new())
+    }
+
+    pub(crate) fn attach(&self, src: &MseSrc) -> Result<(), Error> {
+        if self.ready_state() != ReadyState::Closed {
+            return Err(Error::InvalidState);
+        }
+        self.0.attach(src);
+        Ok(())
+    }
+}
+
+impl MediaSource for GStreamerMediaSource {
+    fn detach(&self) {
+        self.0.detach();
+    }
+
+    fn ready_state(&self) -> ReadyState {
+        match self.0.ready_state() {
+            MediaSourceReadyState::Open => ReadyState::Open,
+            MediaSourceReadyState::Ended => ReadyState::Ended,
+            _ => ReadyState::Closed,
+        }
+    }
+
+    fn duration(&self) -> f64 {
+        seconds(self.0.duration(), f64::INFINITY)
+    }
+
+    fn set_duration(&self, value: f64) -> Result<(), Error> {
+        self.0.set_duration(clock_time(value)?).map_err(map_error)
+    }
+
+    fn add_buffer(&self, media_type: &str) -> Result<Box<dyn SourceBuffer>, Error> {
+        validate_type(media_type)?;
+        let buffer = self.0.add_source_buffer(media_type).map_err(map_error)?;
+        Ok(Box::new(GStreamerSourceBuffer(buffer)))
+    }
+
+    fn remove_buffer(&self, buffer: &dyn SourceBuffer) -> Result<(), Error> {
+        let buffer = (buffer as &dyn Any)
+            .downcast_ref::<GStreamerSourceBuffer>()
+            .ok_or(Error::NotFound)?;
+        self.0.remove_source_buffer(&buffer.0).map_err(map_error)
+    }
+
+    fn buffer_is_active(&self, buffer: &dyn SourceBuffer) -> bool {
+        let Some(buffer) = (buffer as &dyn Any).downcast_ref::<GStreamerSourceBuffer>() else {
+            return false;
+        };
+        let buffers = self.0.active_source_buffers();
+        (0..buffers.length()).any(|index| buffers.index(index).as_ref() == Some(&buffer.0))
+    }
+
+    fn end_of_stream(&self, reason: EndOfStream) -> Result<(), Error> {
+        let reason = match reason {
+            EndOfStream::Normal => MediaSourceEOSError::None,
+            EndOfStream::Network => MediaSourceEOSError::Network,
+            EndOfStream::Decode => MediaSourceEOSError::Decode,
+        };
+        self.0.end_of_stream(reason).map_err(map_error)
+    }
+
+    fn set_live_seekable_range(&self, range: Range<f64>) -> Result<(), Error> {
+        self.0
+            .set_live_seekable_range(clock_time(range.start)?, clock_time(range.end)?)
+            .map_err(map_error)
+    }
+
+    fn clear_live_seekable_range(&self) -> Result<(), Error> {
+        self.0.clear_live_seekable_range().map_err(map_error)
+    }
+}
+
+struct GStreamerSourceBuffer(gstreamer_mse::SourceBuffer);
+
+impl SourceBuffer for GStreamerSourceBuffer {
+    fn set_event_callback(&self, callback: SourceBufferCallback) {
+        let callback = Arc::new(callback);
+        let forward = move |event| {
+            let callback = Arc::clone(&callback);
+            move |_: &gstreamer_mse::SourceBuffer| callback(event)
+        };
+        self.0.connect_on_update_start(forward(Event::UpdateStart));
+        self.0.connect_on_update(forward(Event::Update));
+        self.0.connect_on_update_end(forward(Event::UpdateEnd));
+        self.0.connect_on_error(forward(Event::Error));
+        self.0.connect_on_abort(forward(Event::Abort));
+    }
+
+    fn updating(&self) -> bool {
+        self.0.is_updating()
+    }
+
+    fn buffered(&self) -> Result<Vec<Range<f64>>, Error> {
+        use gstreamer_mse::ffi::{GstMediaSourceRange, gst_source_buffer_get_buffered};
+
+        let mut error = ptr::null_mut();
+        // SAFETY: The source buffer is alive and the C API returns owned references
+        // to the array and to any reported error.
+        unsafe {
+            let array = gst_source_buffer_get_buffered(self.0.to_glib_none().0, &mut error);
+            let mut ranges = Vec::new();
+            if !array.is_null() {
+                let len = (*array).len as usize;
+                if len != 0 {
+                    let intervals = std::slice::from_raw_parts(
+                        (*array).data.cast::<GstMediaSourceRange>(),
+                        len,
+                    );
+                    ranges.extend(intervals.iter().map(|interval| {
+                        (interval.start as f64 / 1e9)..(interval.end as f64 / 1e9)
+                    }));
+                }
+                glib::ffi::g_array_unref(array);
+            }
+            if !error.is_null() {
+                return Err(map_error(from_glib_full(error)));
+            }
+            Ok(ranges)
+        }
+    }
+
+    fn append(&self, data: Vec<u8>) -> Result<(), Error> {
+        self.0
+            .append_buffer(gstreamer::Buffer::from_mut_slice(data))
+            .map_err(map_error)
+    }
+
+    fn remove(&self, range: Range<f64>) -> Result<(), Error> {
+        self.0
+            .remove(clock_time(range.start)?, clock_time(range.end)?)
+            .map_err(map_error)
+    }
+
+    fn abort(&self) -> Result<(), Error> {
+        self.0.abort().map_err(map_error)
+    }
+
+    fn change_type(&self, media_type: &str) -> Result<(), Error> {
+        validate_type(media_type)?;
+        self.0.change_content_type(media_type).map_err(map_error)
+    }
+
+    fn sequence_mode(&self) -> bool {
+        self.0.append_mode() == SourceBufferAppendMode::Sequence
+    }
+
+    fn set_sequence_mode(&self, enabled: bool) -> Result<(), Error> {
+        let mode = if enabled {
+            SourceBufferAppendMode::Sequence
+        } else {
+            SourceBufferAppendMode::Segments
+        };
+        self.0.set_append_mode(mode).map_err(map_error)
+    }
+
+    fn timestamp_offset(&self) -> f64 {
+        seconds(self.0.timestamp_offset(), 0.)
+    }
+
+    fn set_timestamp_offset(&self, value: f64) -> Result<(), Error> {
+        self.0
+            .set_timestamp_offset(clock_time(value)?)
+            .map_err(map_error)
+    }
+
+    fn append_window(&self) -> Range<f64> {
+        seconds(self.0.append_window_start(), 0.)
+            ..seconds(self.0.append_window_end(), f64::INFINITY)
+    }
+
+    fn set_append_window_start(&self, value: f64) -> Result<(), Error> {
+        self.0
+            .set_append_window_start(clock_time(value)?)
+            .map_err(map_error)
+    }
+
+    fn set_append_window_end(&self, value: f64) -> Result<(), Error> {
+        self.0
+            .set_append_window_end(clock_time(value)?)
+            .map_err(map_error)
+    }
+}
+
+fn seconds(time: Option<ClockTime>, missing: f64) -> f64 {
+    time.map_or(missing, |time| time.nseconds() as f64 / 1e9)
+}
+
+fn clock_time(seconds: f64) -> Result<Option<ClockTime>, Error> {
+    if seconds == f64::INFINITY {
+        return Ok(None);
+    }
+    let nanoseconds = seconds * 1e9;
+    if !(0.0..u64::MAX as f64).contains(&nanoseconds) {
+        return Err(Error::InvalidType);
+    }
+    Ok(Some(ClockTime::from_nseconds(nanoseconds as u64)))
+}
+
+fn validate_type(media_type: &str) -> Result<(), Error> {
+    if media_type.is_empty() || media_type.contains('\0') {
+        return Err(Error::InvalidType);
+    }
+    Ok(())
+}
+
+fn map_error(error: glib::Error) -> Error {
+    use gstreamer_mse::MediaSourceError as NativeError;
+
+    match error.kind() {
+        Some(NativeError::Type) => Error::InvalidType,
+        Some(NativeError::NotSupported) => Error::NotSupported,
+        Some(NativeError::NotFound) => Error::NotFound,
+        Some(NativeError::QuotaExceeded) => Error::QuotaExceeded,
+        _ => Error::InvalidState,
+    }
+}
