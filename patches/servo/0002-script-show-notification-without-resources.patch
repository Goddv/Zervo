From 73db5dc4f44c080837464cf40bf8aa888dc7936a Mon Sep 17 00:00:00 2001
From: Goddv <goddv@goddvs-macbook-pro.home>
Date: Sat, 22 Aug 2026 18:03:52 +0200
Subject: [PATCH] script: show a notification that has no resources to fetch

`Notification`'s show steps wait for its image, icon, badge and action icons
to be fetched, and `show` is called from the fetch completion handler once
the last request has landed. A notification carrying none of those queues no
requests at all, so nothing ever completes and `show` is never reached: the
notification is constructed, fires no `error` event, and is simply never
shown to the embedder.

Per the show steps, waiting for an empty set of fetches is over immediately.

This makes `EmbedderMsg::ShowNotification` reachable for the common case of
a plain title-and-body notification, which is what most pages raise.
---
 .../script/dom/serviceworker/notification.rs      | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/components/script/dom/serviceworker/notification.rs b/components/script/dom/serviceworker/notification.rs
index adc3bd0689f..9df8f06aab3 100644
--- a/components/script/dom/serviceworker/notification.rs
+++ b/components/script/dom/serviceworker/notification.rs
@@ -885,6 +885,21 @@ impl Notification {
             }
         }
 
+        // <https://notifications.spec.whatwg.org/#notification-show-steps>
+        // step 2: Wait for any fetches to complete and notification's resources
+        //         to be set.
+        //
+        // A notification with no image, icon, badge or action icons has nothing
+        // to wait for, and the wait is over immediately. Without this, `show`
+        // is unreachable for such a notification: its only other caller is the
+        // fetch completion handler below, and with no request in flight nothing
+        // ever completes to call it — so a plain title-and-body notification is
+        // constructed, fires no `error`, and is simply never shown.
+        if pending_requests.is_empty() {
+            self.show();
+            return;
+        }
+
         for (request, resource_type) in pending_requests {
             self.fetch_and_show_when_ready(request, resource_type);
         }
